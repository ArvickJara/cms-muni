{
    "kind": "collectionType",
    "collectionName": "decretos",
    "info": {
        "singularName": "decreto",
        "pluralName": "decretos",
        "displayName": "Documento Oficial"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "titulo": {
            "type": "string",
            "required": true
        },
        "tipo": {
            "type": "enumeration",
            "enum": [
                "Acuerdos de Concejo",
                "Decretos de Alcaldía",
                "Ordenanzas Municipales",
                "Resoluciones de Alcaldía",
                "Resoluciones de Concejo",
                "Resoluciones Gerenciales",
                "Otros"
            ],
            "required": true,
            "default": "Otros"
        },
        "numero": {
            "type": "string"
        },
        "fecha": {
            "type": "date"
        },
        "archivo": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "files"
            ],
            "required": true
        }
    }
}
